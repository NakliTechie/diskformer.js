{
  "name": "diskformer",
  "version": "0.6.5",
  "description": "Run a model larger than your GPU memory in a browser tab: weights stay in OPFS, WebGPU holds only what each step needs. llama.cpp with paged MoE experts (diskformer/llama), a disk tier, and hand-written MoE engines.",
  "type": "module",
  "license": "MIT",
  "author": "Chirag Patnaik",
  "homepage": "https://github.com/NakliTechie/diskformer.js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NakliTechie/diskformer.js.git"
  },
  "bugs": {
    "url": "https://github.com/NakliTechie/diskformer.js/issues"
  },
  "keywords": [
    "browser",
    "gguf",
    "inference",
    "llama.cpp",
    "llm",
    "moe",
    "offload",
    "opfs",
    "transformers",
    "wasm",
    "webgpu"
  ],
  "files": [
    "index.js",
    "src/",
    "engines/",
    "ggml/llama.js",
    "ggml/worker.mjs",
    "ggml/dist/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./engines/*": "./engines/*",
    "./llama": "./ggml/llama.js",
    "./llama/worker": "./ggml/worker.mjs"
  },
  "scripts": {
    "test": "node test/run.mjs",
    "demo": "node examples/run-demo.mjs",
    "sync": "node scripts/sync-localmind.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
